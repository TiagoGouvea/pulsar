{
  "name": "pulsar-codex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && yarn build:functions && vite build",
    "build:functions": "tsc -p functions/tsconfig.json",
    "preview": "vite preview",
    "test": "yarn test:unit && yarn test:functions && yarn test:emulators",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-pulsar --only firestore 'yarn test:rules:run'",
    "test:rules:run": "vitest run --config vitest.rules.config.ts",
    "test:deletion:emulator": "yarn build:functions && firebase emulators:exec --config firebase.test.json --project demo-pulsar --only auth,firestore,functions 'yarn test:deletion:run'",
    "test:deletion:run": "node --test functions/test/emulator/*.test.mjs",
    "test:emulators": "yarn build:functions && firebase emulators:exec --config firebase.test.json --project demo-pulsar --only auth,firestore,functions 'yarn test:rules:run && yarn test:deletion:run'",
    "test:functions": "yarn build:functions && node --test functions/test/*.test.mjs",
    "test:e2e:emulators": "yarn build:functions && firebase emulators:exec --config firebase.test.json --project demo-pulsar --only auth,firestore,functions 'VITE_AUTH_EMULATOR_PORT=9199 VITE_FIRESTORE_EMULATOR_PORT=8090 VITE_FUNCTIONS_EMULATOR_PORT=5101 playwright test'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint src functions/src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "postinstall": "yarn --cwd functions install --frozen-lockfile --ignore-engines"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^11.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "firebase-tools": "14.22.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.6",
    "terser": "^5.51.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
