# Nunca confirme valores reais. O harness encaminha somente a credencial exigida pelo provedor.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
