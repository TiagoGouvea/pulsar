{
  "name": "pulsar-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:emulator": "VITE_USE_EMULATORS=true vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-pulsar --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "seed": "tsx scripts/seed.ts",
    "icons": "tsx scripts/icons.ts && prettier --write src/design/icons.ts",
    "emulators": "firebase emulators:start --project demo-pulsar --only auth,firestore",
    "e2e:serve": "yarn build:emulator && firebase emulators:exec --project demo-pulsar --only auth,firestore \"yarn seed && yarn preview\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.6",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "firebase": "^11.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.28.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^15.34.1",
    "fontkit": "^2.0.4",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "material-symbols": "0.31.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.3"
  }
}
