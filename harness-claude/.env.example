# Provedores
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
ZAI_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=glm-5.3                # modelo GLM servido nos aliases do Claude Code

# Local
LMSTUDIO_BASE_URL=http://localhost:1235/v1

# Firebase (projeto de desenvolvimento)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-sa.json   # fora do git
FIREBASE_VAPID_KEY=            # public Web Push key (FCM), safe for the client
FIREBASE_WEB_CONFIG_JSON=                                    # config pública do app web

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/pulsar

# Notificações
NOTIFY_WEBHOOK_URL=

# Flags
HARNESS_ALLOW_DEMO_SEED=0
