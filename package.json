{
  "name": "autonomous-development-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "harness": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "axe-core": "4.14.0",
    "eslint": "9.38.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
